# ===========================================================================
# Multilingual file for the TOS 7 Docker application "ghostdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost is a self-hosted publishing platform for blogs, newsletters and paid memberships. Write and publish posts in a modern editor, send newsletters to your subscribers and manage members, tiers and paid subscriptions from one dashboard. This app runs the official Ghost 6.79 image from Docker Hub unmodified as a non-root container on your NAS, keeps posts, images, themes and members in an SQLite database inside the application data folder, and opens from its desktop icon."
release_note = "2. Review remediation of the 6.65.0-2 submission. Upstream image upgraded to Ghost 6.79.0 (published 24 Nov 2026) and pinned by multi-architecture digest. Licence notices corrected: Ghost is MIT, this packaging is MIT, and the icon is the upstream Ghost logo used to identify the app. The privacy policy was rewritten to match what Ghost really stores and sends, including member e-mail addresses and subscriptions, the optional Mailgun and Stripe settings, and the Ghost Explore ping that is enabled by default and can be switched off in Admin > Settings > Ghost Explore. Every third-party endpoint Ghost may contact is now listed. File permissions were tightened (umask 077, database 0600, non-root, cap_drop ALL), the data folder and its deletion are documented, and both architectures were rebuilt deterministically so the published SHA-256 matches."
important    = "Requires DockerEngine (installed automatically if missing). The image is pulled from Docker Hub at install time, so configure a registry mirror in DockerEngine if your NAS cannot reach it. All data lives in /Volume1/DockerAppData/ghostdocker/content. The first time you open the app it learns the address you used, which takes about 20 seconds, so links and newsletters use the right address. Back up the data folder before uninstalling with data removal."

[zh-cn]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost 是自托管的专业发布平台，可用来搭建博客、邮件通讯与付费会员站点。在现代化编辑器中撰写与发布文章、向订阅者发送通讯、统一管理会员、订阅层级与付费订阅。本应用在 NAS 上以非 root 容器运行 Docker Hub 官方 Ghost 6.79 镜像（未做修改），文章、图片、主题与会员数据都保存在应用数据目录内的 SQLite 数据库中，重启与更新都不会丢失，从桌面图标打开即可使用。"
release_note = "2. 针对 6.65.0-2 上架审核意见的整改版本。上游镜像升级到 Ghost 6.79.0（2026 年 11 月 24 日发布）并按多架构 digest 固定。修正许可声明：Ghost 为 MIT，打包部分为 MIT，图标为上游 Ghost 标识（仅用于指明应用）。隐私政策按实际存储与外发重写，涵盖会员邮箱与订阅、可选的 Mailgun 与 Stripe 配置，以及默认开启、可在「后台 - 设置 - Ghost Explore」关闭的 Explore 上报。第三方接口清单一并补全。收紧文件权限（umask 077、数据库 0600、非 root、cap_drop ALL），并写明数据目录与卸载删除方式。双架构已确定性重建，发布校验和与本地 sha256 一致。"
important    = "需要 DockerEngine（缺失时应用中心会自动提示安装）。容器镜像在安装时从 Docker Hub 拉取，若 NAS 无法直连，请先在 DockerEngine 中配置镜像加速。所有数据位于 /Volume1/DockerAppData/ghostdocker/content。首次打开应用时它会自动识别你访问所用的地址并完成配置，约需 20 秒，之后的链接与通讯邮件才会使用正确地址。卸载并删除数据前请先备份应用数据目录。"

[zh-hk]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost 是自架的專業發佈平台，可用來建立網誌、電子報與付費會員網站。在現代化編輯器中撰寫與發佈文章、向訂閱者發送電子報、統一管理會員、訂閱層級與付費訂閱。本應用在 NAS 上以非 root 容器執行 Docker Hub 官方 Ghost 6.79 映像（未做修改），文章、圖片、主題與會員資料都保存在應用資料目錄內的 SQLite 資料庫中，重新啟動與更新都不會遺失，從桌面圖示開啟即可使用。"
release_note = "2. 針對 6.65.0-2 上架審核意見的整改版本。上游映像升級到 Ghost 6.79.0（2026 年 11 月 24 日發佈）並按多架構 digest 固定。修正授權聲明：Ghost 為 MIT，打包部分為 MIT，圖示為上游 Ghost 標識（僅用於指明應用）。私隱政策按實際儲存與外發重寫，涵蓋會員電郵與訂閱、可選的 Mailgun 與 Stripe 設定，以及預設開啟、可在「後台 - 設定 - Ghost Explore」關閉的 Explore 上報。第三方介面清單一併補全。收緊檔案權限（umask 077、資料庫 0600、非 root、cap_drop ALL），並寫明資料目錄與解除安裝刪除方式。雙架構已確定性重建，發佈校驗和與本地 sha256 一致。"
important    = "需要 DockerEngine（缺少時應用中心會自動提示安裝）。容器映像在安裝時從 Docker Hub 下載，若 NAS 無法直連，請先在 DockerEngine 中設定映像加速。所有資料位於 /Volume1/DockerAppData/ghostdocker/content。首次開啟應用時它會自動辨識你存取所用的位址並完成設定，約需 20 秒，之後的連結與電子報才會使用正確位址。解除安裝並刪除資料前請先備份應用資料目錄。"

