# ===========================================================================
# Multilingual file for the TOS 7 Docker application "ghostdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost is a self-hosted publishing platform for blogs, newsletters and paid memberships. Write and publish posts in a modern editor, send newsletters to your subscribers and manage members from one dashboard. This app runs the official Ghost image from Docker Hub in a container on your NAS, keeps posts, images, themes and members in an SQLite database inside the application data folder (so they survive restarts and updates), and opens from its desktop icon."
release_note = "1. First release: Ghost 6.65.0 (official Docker Hub image, unmodified) as a non-root TOS 7 container with an embedded SQLite database, automatic detection of the address you reach the blog on, and 23-language store metadata."
important    = "Requires DockerEngine (installed automatically if missing). The image is pulled from Docker Hub at install time; configure a registry mirror in DockerEngine if your NAS cannot reach it. All data lives in /Volume1/DockerAppData/ghostdocker/content. The first time you open the app it detects the address you used and configures itself - give it about 20 seconds. To pin a fixed address instead, edit content/public-url.txt. Back up the data folder before uninstalling with data removal."

[zh-cn]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost 是自托管的专业发布平台，可用来搭建博客、邮件通讯与付费会员站点。在现代化编辑器中撰写与发布文章、向订阅者发送通讯、统一管理会员与订阅。本应用在 NAS 上以非 root 容器运行 Docker Hub 官方镜像，文章、图片、主题与会员数据都保存在应用数据目录内的 SQLite 数据库中，重启与更新都不会丢失；从桌面图标打开即可使用。"
release_note = "1. 首次发布：Docker Hub 官方镜像 Ghost 6.65.0（未做修改），以非 root 容器运行于 TOS 7，内置 SQLite 数据库，自动识别博客访问地址，商店文案覆盖 23 种语言。"
important    = "需要 DockerEngine（缺失时应用中心会自动提示安装）。容器镜像在安装时从 Docker Hub 拉取；若 NAS 无法直连，请先在 DockerEngine 中配置镜像加速。所有数据位于 /Volume1/DockerAppData/ghostdocker/content。首次打开应用时它会自动识别你访问所用的地址并完成配置，大约需要 20 秒。如需固定地址，可编辑 content/public-url.txt。卸载并删除数据前请先备份应用数据目录。"

[zh-hk]
name         = "Ghost"
auth         = "Ghost Foundation"
version      = "@@VERSION@@"
descript     = "Ghost 是自架的專業發佈平台，可用來建立網誌、電子報與付費會員網站。在現代化編輯器中撰寫與發佈文章、向訂閱者發送電子報、統一管理會員與訂閱。本應用在 NAS 上以非 root 容器執行 Docker Hub 官方映像，文章、圖片、主題與會員資料都保存在應用資料目錄內的 SQLite 資料庫中，重新啟動與更新都不會遺失；從桌面圖示開啟即可使用。"
release_note = "1. 首次發佈：Docker Hub 官方映像 Ghost 6.65.0（未做修改），以非 root 容器執行於 TOS 7，內建 SQLite 資料庫，自動辨識網誌存取位址，商店文案涵蓋 23 種語言。"
important    = "需要 DockerEngine（缺少時應用中心會自動提示安裝）。容器映像在安裝時從 Docker Hub 下載；若 NAS 無法直連，請先在 DockerEngine 中設定映像加速。所有資料位於 /Volume1/DockerAppData/ghostdocker/content。首次開啟應用時它會自動辨識你存取所用的位址並完成設定，約需 20 秒。如需固定位址，可編輯 content/public-url.txt。解除安裝並刪除資料前請先備份應用資料目錄。"

